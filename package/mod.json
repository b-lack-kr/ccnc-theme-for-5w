{
  "id": "blackr-ccnc-theme-for-5w",
  "name": "ccNC Theme for 5W",
  "version": "0.1.45",
  "description": "5W 내비게이션의 미디어 정보, 음량 표시 및 오른쪽 분할 화면을 구성하는 테마입니다.",
  "authors": ["blackr"],
  "live": true,
  "apps": [{"apk": "app/Shortcuts.apk", "package": "dev.blackr.ccnc.shortcuts"}],
  "input": [
    {"key": "navi", "press": "short", "stock": "replace", "send": "navi hold", "when": "settings.navi_swap_enabled"},
    {"key": "navi", "press": "hold", "send": "navi short", "when": "settings.navi_swap_enabled"}
  ],
  "hooks": {
    "jar": "hooks.jar",
    "entry": "dev.ev6.ccnc_media.UniversalEntry",
    "points": {}
  }
}
